<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="Hex" android:icon="@android:drawable/ic_btn_speak_now">
        <service android:name=".HexInputMethodService"
                 android:permission="android.permission.BIND_INPUT_METHOD"
                 android:exported="true">
            <intent-filter><action android:name="android.view.inputmethod.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>
        <activity android:name="cl.maarmapa.hexandroid.settings.SettingsActivity"
                  android:exported="true"
                  android:label="Hex — ajustes"/>
    </application>
</manifest>
